{
  "name": "autonomia-digital",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app tests *.ts *.json .prettierrc.json",
    "format:check": "prettier --check app tests *.ts *.json .prettierrc.json",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e && npm run format:check"
  },
  "dependencies": {
    "@xstate/react": "6.1.0",
    "dexie": "4.4.6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
